# PostgreSQL local creado para Tu Billetera.
# En otra máquina o servidor, reemplazar por una URL PostgreSQL privada.
DATABASE_URL="postgresql://127.0.0.1:5432/tu_billetera"

# Inicio de sesión con Google (solo en el servidor).
AUTH_SECRET="genera-un-valor-aleatorio-de-al-menos-32-caracteres"
AUTH_GOOGLE_ID="cliente-oauth-de-google.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="secreto-oauth-de-google"

# Correos de Google autorizados, separados por coma. En producción es obligatorio.
AUTH_ALLOWED_EMAILS="angie@example.com,jordan@example.com"

# Cuenta que recibe una sola vez los datos históricos de la antigua billetera
# compartida al activar el aislamiento por usuario.
BILLETERA_LEGACY_OWNER_EMAIL="angie@example.com"

# Solo para trabajar localmente sin OAuth. Nunca configurarlo en Vercel.
AUTH_LOCAL_BYPASS="false"

# Puerto local opcional.
HOST="127.0.0.1"
PORT="3002"
