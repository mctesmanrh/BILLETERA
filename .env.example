# URL pública del proyecto Supabase. No contiene credenciales.
SUPABASE_URL="https://ykjemmwzkhgjvxgjkmoh.supabase.co"

# Clave secreta moderna (sb_secret_...) del proyecto.
# Obtenerla en Supabase > Settings > API Keys y guardarla solo en .env.local.
# Nunca usar un prefijo VITE_ ni enviar esta clave al navegador.
SUPABASE_SECRET_KEY="PEGA_AQUI_TU_CLAVE_SECRETA"

# Puerto local opcional.
PORT="3000"
