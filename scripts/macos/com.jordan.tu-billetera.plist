  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/private/tmp/tu-billetera-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/private/tmp/tu-billetera-launchd.err.log</string>
</dict>
